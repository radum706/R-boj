{
  "manifest_version": 3,
  "name": "Răboj",
  "version": "1.0.0",
  "description": "Sidebery-style tree tabs, panels, bookmarks and snapshots in the side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "unlimitedStorage", "sidePanel", "bookmarks", "alarms", "favicon"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidebar.html" },
  "options_page": "options.html",
  "action": { "default_title": "Răboj" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Open the sidebar" },
    "next-panel": { "suggested_key": { "default": "Alt+Shift+Right" }, "description": "Next panel" },
    "prev-panel": { "suggested_key": { "default": "Alt+Shift+Left" }, "description": "Previous panel" },
    "new-child-tab": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "New child tab of the active tab" },
    "toggle-branch": { "description": "Collapse / expand the active tab's branch" },
    "close-branch": { "description": "Close the active tab and its branch" },
    "snapshot": { "description": "Take a snapshot now" }
  }
}
